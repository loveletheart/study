STUDY_APP_NAME="Study API"
# Relative paths are resolved from the project root.
STUDY_DATABASE_PATH=study.db
STUDY_WEATHER_TIMEOUT_SECONDS=10
STUDY_WEATHER_CACHE_TTL_SECONDS=600

# Local Ollama server. Set the exact model name shown by ollama list.
STUDY_LLM_BASE_URL=http://127.0.0.1:11434
STUDY_LLM_MODEL=
STUDY_LLM_TIMEOUT_SECONDS=180
# Lower this for limited memory; weekly output also needs enough context.
STUDY_LLM_CONTEXT_SIZE=16384
